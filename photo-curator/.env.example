# ── Photo Curator — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Path to your photos on the Docker HOST machine
# This gets mounted into the container at /mnt/nas/photos
PHOTO_DIR=/mnt/ssd1/photos

# Path where print exports will be saved on the HOST machine
EXPORT_DIR=/mnt/ssd1/exports

# Port the web UI is available on (open http://your-machine-ip:8000)
APP_PORT=8000

# ── Advanced settings (safe to leave as defaults) ─────────────────────────────

# Processing device: "cuda" for GPU (recommended), "cpu" for CPU-only
DEVICE=cuda

# Path inside the container where the SQLite database is stored
DB_PATH=/data/photo_curator.db

# How many photos to score in one GPU batch (reduce if you run out of VRAM)
BATCH_SIZE=32

# Print export resolution in DPI (300 is standard for photo printing)
EXPORT_DPI=300
